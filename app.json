{
  "expo": {
    "name": "Field Service Journal",
    "slug": "field-service-journal-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-master-dark-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg",
          "telegram",
          "whatsapp",
          "tg",
          "telegram"
        ],
        "NSPhotoLibraryUsageDescription": "Field Service Journal uses your photo library so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.fieldservicejournalapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-adaptive-foreground.png",
        "backgroundColor": "#1C2B4A",
        "monochromeImage": "./assets/icons/icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.anonymous.fieldservicejournalapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icons/icon-monochrome.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Field Service Journal uses your photo library so you can choose a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon-monochrome.png",
          "color": "#1C2B4A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field Service Journal uses your location to fill in a contact's address for you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-light.png",
          "backgroundColor": "#FAFAF8",
          "dark": {
            "image": "./assets/splash/splash-dark.png",
            "backgroundColor": "#1C2B4A"
          },
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "cd984473-27c3-4a12-9fd5-0272ccc62dd7"
      }
    }
  }
}
